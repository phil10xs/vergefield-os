# Copy to .env.local and adjust.
# Local Homebrew Postgres (default):
DATABASE_URL=postgres://igbobaphilip@localhost:5432/vergefield
# Docker alternative (`docker compose up -d`, avoids clashing with the default Postgres on 5432):
# DATABASE_URL=postgres://postgres:postgres@localhost:5433/vergefield
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Meta Model API key (Meta dashboard) — enables video transcription.
# Without it, requests still work; transcripts show as unavailable.
META_MODEL_API_KEY=
# SES (optional) — sends magic-link emails. Leave unset locally: the UI says
# nothing was sent and still opens the board on-screen.
# SES_FROM_EMAIL=
# SES_FROM_NAME=VergeCare
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
